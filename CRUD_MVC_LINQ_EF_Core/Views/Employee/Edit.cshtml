@model CRUD_MVC_LINQ_EF_Core.Models.Employee

<h2>Edit Employee</h2>
<hr />
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="id" />
    <div class="form-group mb-2">
        <label asp-for="ename"></label>
        <input asp-for="ename" class="form-control" />
    </div>
    <div class="form-group mb-2">
        <label asp-for="Age"></label>
        <input asp-for="Age" class="form-control" />
    </div>
    <div class="form-group mb-2">
        <label asp-for="salary"></label>
        <input asp-for="salary" class="form-control" />
    </div>
    <div class="form-group mb-2">
        <label asp-for="Department"></label>
        <input asp-for="Department" class="form-control" />
    </div>
    <div class="form-group mb-2">
        <label asp-for="Manager_Id"></label>
        <input asp-for="Manager_Id" class="form-control" />
    </div>
    <div class="form-group mb-3">
        <label asp-for="Email_Id"></label>
        <input asp-for="Email_Id" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>